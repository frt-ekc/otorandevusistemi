NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Günlük randevu raporu (her akşam 23:00-23:59 arası ertesi günün randevuları mail olarak gelir)
# vercel.json'daki zamanlama UTC'dir: 20:00 UTC = 23:00 İstanbul
CRON_SECRET="uzun-rastgele-bir-metin"
RESEND_API_KEY="re_xxxxxxxx"
RAPOR_MAIL_ADRESI="ornek@gmail.com"
# Randevu sonrası müşteriye WhatsApp onay mesajı (Meta WhatsApp Cloud API) — kurulum: docs/whatsapp-kurulum.md
# Bunlar boşsa mesaj gönderilmez, randevu yine normal alınır.
WHATSAPP_TOKEN="kalici-erisim-anahtari"
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
WHATSAPP_TEMPLATE_NAME="randevu_onay"
WHATSAPP_TEMPLATE_LANG="tr"
